# Copy to .env and fill in real values. Never commit .env.
APP_NAME="Dhan Setu API"
ENVIRONMENT=local
# true = OTPs are also returned in API responses as dev_otp (ignored in production).
DEBUG=false

DATABASE_URL=postgresql+asyncpg://dhansetu:CHANGE_ME@localhost:5432/dhansetu
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0

# Auth. Generate the secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_AT_LEAST_32_CHARACTERS_LONG
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# One-time codes by SMS (for now a stub that writes the code to the server log)
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Payments. "fake" settles payments in memory with no real money (refused in production).
# For Razorpay test mode: Dashboard (Test Mode) -> Settings -> API Keys, and
# Settings -> Webhooks for the webhook secret (16+ characters). Use rzp_test_ keys
# everywhere except production, which requires rzp_live_ keys.
PAYMENT_GATEWAY=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TIMEOUT_SECONDS=10
# KYC (Aadhaar + PAN through DigiLocker, plus a selfie). "fake" verifies anyone with
# test data (refused in production); "none" turns KYC off, so nobody can be verified.
KYC_PROVIDER=fake
# Encrypts KYC personal data in the database. Required unless KYC_PROVIDER=none. Generate:
#   python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep it safe: losing it makes stored KYC data unreadable.
KYC_ENCRYPTION_KEY=
KYC_ATTEMPTS_PER_DAY=5
KYC_SELFIE_ATTEMPTS_PER_DAY=5
# Lowest selfie-to-Aadhaar-photo match score that passes (70-100).
KYC_SELFIE_MIN_MATCH_SCORE=80
# This API's public address; DigiLocker sends users back to it (https in production).
PUBLIC_BASE_URL=http://localhost:8000
# The app's deep link the KYC callback opens afterwards.
KYC_APP_RETURN_URL=dhansetu://kyc/digilocker

# Each new card is checked with a ₹1 charge (refunded at once). Caps against card testing.
CARD_VERIFICATIONS_PER_DAY=5
MAX_CARDS_PER_USER=10
# Card payments. Amounts are in paise (₹1 = 100). 10000000 = ₹1,00,000.
MAX_PAYMENT_AMOUNT_PAISE=10000000
PAYMENT_EXPIRY_MINUTES=30
PAYMENT_SYNC_INTERVAL_SECONDS=5

# Browser origins allowed by CORS, as a JSON list. Empty = CORS off (the mobile app doesn't need it).
CORS_ORIGINS=[]

# Only for docker-compose.yml (Postgres container password). Must match DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME
